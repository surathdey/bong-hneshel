# ==========================================
# Environment & Secrets (High Security)
# ==========================================
.env
.env.*
*.env
*.env.local
*.pem
*.key
*token.json*
*credentials.json*
.credentials
memory/test_credentials.md

# Allow example / template files only
!.env.example
!backend/.env.example
!frontend/.env.example

# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==========================================
# Logs & Process IDs
# ==========================================
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.pid
.backend.pid
dump.rdb

# ==========================================
# Node / Expo / Next.js
# ==========================================
node_modules/
/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Expo & Web Dist Exception Handling
!backend/web_dist/**
!backend/web_dist/**/node_modules
!backend/web_dist/**/node_modules/**
!frontend/dist/**
!frontend/dist/**/node_modules
!frontend/dist/**/node_modules/**

.expo/
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo
.cache/

# ==========================================
# IDEs & System Files
# ==========================================
.DS_Store
.idea/
.vscode/
.vercel
.ipynb_checkpoints/
.ac
chainlit.md
.chainlit

# ==========================================
# Testing & Reports
# ==========================================
/coverage
test_reports/
/tests/output/

# ==========================================
# Large Archives
# ==========================================
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
