# ==============================================================================
# Bong Hneshel — Backend Environment Configuration Template (.env.example)
# ==============================================================================

# --- Database Configuration (REQUIRED) ---
MONGO_URL=mongodb://127.0.0.1:27017/?directConnection=true&serverSelectionTimeoutMS=2000&appName=mongosh+2.10.0
DB_NAME=bong_hneshel_db

# --- Authentication & Admin Credentials ---
JWT_SECRET=your_long_random_jwt_secret_here
ADMIN_EMAIL=admin@bong-hneshel.ca
ADMIN_PASSWORD=your_secure_admin_password

# --- Server & Public URLs ---
PORT=8002
PUBLIC_BASE_URL=http://13.222.67.9:8082
EXPO_PUBLIC_BACKEND_URL=http://13.222.67.9:8082

# --- Brand & Email Settings ---
BRAND_NAME=Bong Hneshel
EMAIL_FROM=orders@bong-hneshel.ca
EMAIL_FROM_NAME=Bong Hneshel
EMAIL_REPLY_TO=support@bong-hneshel.ca

# --- Stripe Payments ---
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- External Integrations ---
EMERGENT_LLM_KEY=
EMERGENT_EMAIL_KEY=
GOOGLE_MAPS_API_KEY=
INTEGRATIONS_FERNET_KEY=
